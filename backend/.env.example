# ── Copy this to backend/.env and fill in your values ──────────────────────
# Uses SQLite locally — no Postgres/Docker needed.
# For production: set DATABASE_URL=postgresql+asyncpg://...

DATABASE_URL=sqlite+aiosqlite:////tmp/jadb/jobagent.db
REDIS_URL=redis://localhost:6379/0   # Optional — in-memory fallback used if Redis unavailable

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# Your Gemini API key from https://aistudio.google.com/
SYSTEM_GEMINI_KEY=

# Payments (leave empty to skip payment gating)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (leave empty to skip email sending)
RESEND_API_KEY=

FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=your@email.com
