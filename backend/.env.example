# ── Copy this to backend/.env and fill in your values ──────────────────────
# The backend reads DATABASE_URL and works with SQLite (local) or any Postgres.
# Switching DB providers is JUST this one variable — no code change.

# Local dev (default): SQLite, no Postgres/Docker needed.
DATABASE_URL=sqlite+aiosqlite:////tmp/jadb/jobagent.db
#
# Production: a managed Postgres. Railway's free plan expires (which wipes the
# DB and makes login fail); these free, always-on serverless options are drop-in
# replacements. Use the +asyncpg prefix (a bare postgres:// URL is auto-coerced).
#   Neon (recommended — free, serverless):
#     DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/dbname?sslmode=require
#   Supabase:
#     DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# After switching, verify with:  curl /health  → {"database":"ok"}
# Full steps: docs/DATABASE.md

REDIS_URL=redis://localhost:6379/0   # Optional — in-memory fallback used if Redis unavailable

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# Your Gemini API key from https://aistudio.google.com/
SYSTEM_GEMINI_KEY=

# Payments (leave empty to skip payment gating)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (leave empty to skip email sending)
RESEND_API_KEY=

FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=your@email.com
