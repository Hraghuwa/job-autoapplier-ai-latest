# Copy to .env.prod on the VM and fill in real values. Do NOT commit .env.prod.
#   cp .env.prod.example .env.prod && nano .env.prod

# --- Public hostname (points DNS at this VM's IP; Caddy gets HTTPS for it) ---
# A free DuckDNS subdomain works: e.g. jobagent.duckdns.org
DOMAIN=jobagent.duckdns.org

# --- Postgres (compose creates this DB; pick any strong password) ---
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=jobagent

# --- App secrets (REQUIRED) ---
# Generate SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Frontend origin (your Vercel URL) for CORS ---
FRONTEND_URL=https://your-frontend.vercel.app

# --- LLM providers (fill the ones you use) ---
GEMINI_API_KEY=
SYSTEM_GEMINI_KEY=
GROQ_API_KEY=
# OLLAMA_HOST=http://host.docker.internal:11434

# DATABASE_URL and REDIS_URL are set automatically by docker-compose.prod.yml
# to the internal postgres/redis services — do not set them here.
