{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend (FastAPI)",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "Frontend (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "Celery Worker",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "celery",
        "-A",
        "backend.workers.celery_app",
        "worker",
        "-B",
        "-s",
        "/tmp/celerybeat-schedule",
        "--loglevel=info",
        "-Q",
        "agents,default"
      ],
      "port": null
    },
    {
      "name": "Redis",
      "runtimeExecutable": "redis-server",
      "runtimeArgs": [
        "--daemonize",
        "no"
      ],
      "port": 6379
    }
  ]
}
