# ── Frontend local dev environment ──────────────────────────────────────────
# Copy to frontend/.env.local (never commit that file).
#
# In PRODUCTION on Vercel you do NOT need any NEXT_PUBLIC_ vars.
# Just set BACKEND_URL (private) in Vercel → Project Settings → Environment Variables.
#
# LOCAL DEV ONLY — bypass the Next.js proxy and hit the backend directly:
# NEXT_PUBLIC_API_URL=http://localhost:8000
